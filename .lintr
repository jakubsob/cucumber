linters: linters_with_defaults(
    line_length_linter(120),
    commented_code_linter = NULL,
    object_name_linter = object_name_linter(c("snake_case", "SNAKE_CASE", "CamelCase"))
  )
exclusions: list(
    # Generated by update_gherkin()
    "R/gherkin_states.R",
    # Helpers that use testthat, attached when they run
    "tests/acceptance/setup-steps.R" = list(object_usage_linter = Inf),
    "tests/testthat/test-cucumber_expressions.R" = list(object_usage_linter = Inf),
    "tests/testthat/test-gherkin.R" = list(object_usage_linter = Inf),
    "tests/testthat/test-messages-read.R" = list(object_usage_linter = Inf),
    "inst/examples/custom_loading/tests/acceptance/support/expect.R" = list(object_usage_linter = Inf)
  )
